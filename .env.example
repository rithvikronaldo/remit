# Copy to .env and fill in. Phase 0 (the generator) needs none of these —
# they come online from Phase 1 (corpus/retrieval) onward.

# Claude — decisions (Phase 2) + vision extraction (Phase 4)
ANTHROPIC_API_KEY=

# Postgres (pgvector enabled) — see docker-compose.yml
DATABASE_URL=postgresql://remit:remit@localhost:5432/remit

# Embedding model for retrieval (Phase 1)
EMBEDDING_MODEL=

# Below this confidence a RAG decision escalates (Phase 2)
DECISION_CONFIDENCE_THRESHOLD=0.70

# Optional — LangChain chain tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
